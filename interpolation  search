def interpolation_search(arr, x):
    low = 0
    high = len(arr) - 1

    while low <= high and x >= arr[low] and x <= arr[high]:
        if arr[high] == arr[low]:
            if arr[low] == x:
                print(f"we found x at index {low}")
                return low
            else:
                break

        
        pos = low + ((x - arr[low]) * (high - low)) // (arr[high] - arr[low])

        if arr[pos] == x:
            print(f"we found x at index {pos}")
            return pos
        elif arr[pos] < x:
            low = pos + 1
        else:
            high = pos - 1

    print("not found")
    return -1

arr = [1,5,6,8,9,12,13]
interpolation_search(arr, 12)  
 
