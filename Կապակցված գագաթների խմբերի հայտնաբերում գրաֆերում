def connected_components(graph):
    visited = set()
    components = []

    for v in graph:
        if v not in visited:
            stack = [v]
            comp = []
            visited.add(v)
            while stack:
                x = stack.pop()
                comp.append(x)
                for u in graph.get(x, []):
                    if u not in visited:
                        visited.add(u)
                        stack.append(u)
            components.append(comp)

    return components


graph = {
    1: [2],
    2: [1, 3],
    3: [2],
    4: [5],
    5: [4],
    6: []
}

print(connected_components(graph))
