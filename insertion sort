n = int(input("enter n")) 
array =[] 
for i in range(n): 
    x = int(input(f"enter {i+1} element ")) 
    array.append(x)

for i in range(1, n)):
    key = array[i]
    j = i - 1
    
    while j >= 0 and array[j] > key:
        array[j + 1] = array[j]
        j -= 1
    
    array[j + 1] = key

print(array)
