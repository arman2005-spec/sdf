def floyd_warshall(graph):
    n = len(graph)
    dist = [[float("inf")]*n for _ in range(n)]
    for i in range(n):
        dist[i][i] = 0
    for u in graph:
        for v, w in graph[u]:
            dist[u][v] = w
    for k in range(n):
        for i in range(n):
            for j in range(n):
                if dist[i][k] + dist[k][j] < dist[i][j]:
                    dist[i][j] = dist[i][k] + dist[k][j]
    return dist


graph = {
    0: [(1, 5), (3, 10)],
    1: [(2, 3)],
    2: [(3, 1)],
    3: []
}

distances = floyd_warshall(graph)
for row in distances:
    print(row)
