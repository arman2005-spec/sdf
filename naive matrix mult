import numpy as np

def naive_matrix_mult(a, b):
    n = len(a)
    m = len(b[0])
    p = len(b)
    c = np.zeros((n, m), dtype=int)
    for i in range(n):
        for j in range(m):
            for k in range(p):
                c[i][j] += a[i][k] * b[k][j]
    return c

a = np.array([[1, 2], [3, 4]])
b = np.array([[5, 6], [7, 8]])
print(naive_matrix_mult(a, b))
