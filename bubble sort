n = int(input("Enter number of elements: "))
array = []

for i in range(n):
    x = int(input(f"Enter element {i+1}: "))
    array.append(x)

# Bubble Sort
for i in range(n):
    for j in range(0, n - i - 1):
        if array[j] > array[j + 1]:
            array[j], array[j + 1] = array[j + 1], array[j]  # Swap

print("Sorted array:", array)

