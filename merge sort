def merge_sort(x: list):
    if len(x) <= 1:
        return x

    kes = len(x) // 2
    aj = merge_sort(x[kes:])
    dzax = merge_sort(x[:kes])

    return merge(aj, dzax)

def merge(x, y):
    a = []
    i = 0
    j = 0

    while i < len(x) and j < len(y):
        if x[i] < y[j]:
            a.append(x[i])
            i += 1
        else:
            a.append(y[j])
            j += 1

    a.extend(x[i:])
    a.extend(y[j:])

    return a

print(merge_sort([5, 6.2, 7, 1]))
