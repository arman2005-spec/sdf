def binary_search(arr, left, right, x):
    while left <= right:
        mid = left + (right - left) // 2
        if arr[mid] == x:
            return mid
        elif arr[mid] < x:
            left = mid + 1
        else:
            right = mid - 1
    return -1


def exponential_search(arr, x):
    n = len(arr)
     
    if arr[0] == x:
        print(f"we found x at index 0")
        return 0
    
  
    i = 1
    while i < n and arr[i] <= x:
        i *= 2
    
    result = binary_search(arr, i // 2, min(i, n - 1), x)
    if result != -1:
        print(f"we found x at index {result}")
    else:
        print("not found")
    return result


arr = [1,2,8,9,12,16] 
exponential_search(arr, 12) 

