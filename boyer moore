def bad_char_table(pattern):
    table = {}
    for i in range(len(pattern)):
        table[pattern[i]] = i
    return table

def boyer_moore(text, pattern):
    m = len(pattern)
    n = len(text)
    if m == 0:
        return 0

    table = bad_char_table(pattern)
    shift = 0

    while shift <= n - m:
        j = m - 1
        while j >= 0 and pattern[j] == text[shift + j]:
            j -= 1

        if j < 0:
            print("Pattern found at index", shift)
            return shift
        else:
            char = text[shift + j]
            shift += max(1, j - table.get(char, -1))

    print("Pattern not found")
    return -1

text = "egwvwecwewrasd"
pattern = "as"
boyer_moore(text, pattern)
