import heapq

def dijkstra(graph, start):
    dist = {v: float("inf") for v in graph}
    dist[start] = 0
    pq = [(0, start)]

    while pq:
        d, u = heapq.heappop(pq)
        if d > dist[u]:
            continue
        for v, w in graph[u]:
            nd = d + w
            if nd < dist[v]:
                dist[v] = nd
                heapq.heappush(pq, (nd, v))

    return dist


graph = {
    1: [(2, 4), (3, 1)],
    2: [(4, 1)],
    3: [(2, 2), (4, 5)],
    4: []
}

print(dijkstra(graph, 1))
